# =================================================================
# Dental & Orthopedic Clinic Management System - Environment Config
# =================================================================
# Copy this file to .env before starting Docker:
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / macOS:       cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL Container)
# -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=clinic_secure_pass_2026
POSTGRES_DB=clinic_db

# NOTE: PostgreSQL is kept strictly internal to the Docker network.
# Port 5432 is NOT exposed to the host to eliminate any collisions with local PostgreSQL.
# The entrypoint script automatically encodes special characters in passwords into a safe DATABASE_URL.

# -----------------------------------------------------------------
# 2. APPLICATION RUNTIME & SECURITY
# -----------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Secure JWT signing secret for auth tokens.
# A unique 256-bit cryptographic token must be provided.
# Generate your own unique production key using either:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=b408087e71b84b788eb43e3327168bc2b0ea35cf68cd509a8d166d7599323ba5

# Allowed CORS origins (matches frontend gateway URL)
CORS_ORIGIN="http://localhost:8080"

# -----------------------------------------------------------------
# 3. CONTAINER GATEWAY PORT
# -----------------------------------------------------------------
# Host port for the Frontend Web Application & Gateway (Nginx)
# Defaults to 8080 to avoid collisions with host web servers on port 80
FRONTEND_PORT=8080

# NOTE: The Backend API is kept internal to the Docker network.
# All REST API (/api/*) and WebSocket (/socket.io/*) traffic is routed
# through the Nginx frontend gateway on port 8080.

# -----------------------------------------------------------------
# 4. INITIAL MASTER CREDENTIALS (FROM seed.ts)
# -----------------------------------------------------------------
# Initial Login:
#   Username: admin
#   Password: admin123
#   Role:     ADMIN (Administrator)
# The Administrator creates Doctor and Receptionist accounts in the Admin Portal.
#
# CRITICAL SECURITY NOTICE:
# The Administrator must change the initial password ('admin123') immediately 
# after the first login under Admin Portal > User Management.
